# ==============================================================================
# AXIAVONE PUBLIC STOREFRONT — ENVIRONMENT VARIABLES
# ==============================================================================
# SECURITY NOTICE:
# - Variables prefixed with NEXT_PUBLIC_ or VITE_ are bundled into client JS.
# - NEVER put SUPABASE_SERVICE_ROLE_KEY or AXIAVONE_INTERNAL_SECRET in client vars.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PUBLIC CLIENT KEYS (Safe to expose to browser; protected by Supabase RLS)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key"
NEXT_PUBLIC_SITE_URL="https://store.axiavone.com"

# Optional Vite aliases if running the local Express+Vite preview against Supabase
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key"

# ------------------------------------------------------------------------------
# 2. SERVER-ONLY SECRETS (Vercel Encrypted Env Vars / Server Runtime ONLY)
# ------------------------------------------------------------------------------
# Bypasses RLS for /api/ai-sync automated publishing from AXIAVONE HQ
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key"

# High-entropy shared bearer secret (openssl rand -hex 32) used by DIV-08/09/15/21
AXIAVONE_INTERNAL_SECRET="replace-with-64-char-hex-secret"

# ------------------------------------------------------------------------------
# 3. AI STUDIO RUNTIME VARIABLES
# ------------------------------------------------------------------------------
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
